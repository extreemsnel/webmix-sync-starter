#!/usr/bin/env bash
# Build site-urls.tsv (site key <TAB> home URL) by asking each server for its WordPress URL.
# Re-running only fills in sites that are missing or blank. Use --all to refresh everything.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/common.sh"

MAP_FILE="$(dirname "$SITES_DIR")/site-urls.tsv"
touch "$MAP_FILE"
[[ "${1:-}" == "--all" ]] && : > "$MAP_FILE"

lookup_url() {
  load_site_config "$1" >/dev/null || return
  local wp_root="$REMOTE_ROOT"
  [[ "$(basename "$wp_root")" == "wp-content" ]] && wp_root="$(dirname "$wp_root")"

  # WP-CLI first, wp-config.php constants as fallback; first URL in the output wins.
  local remote="cd $(printf '%q' "$wp_root") && { wp option get home 2>/dev/null; grep -E 'WP_HOME|WP_SITEURL' wp-config.php 2>/dev/null; }"
  eval "$(build_ssh_cmd) -n -o ConnectTimeout=10 $(printf '%q' "$SSH_USER@$SSH_HOST") $(printf '%q' "$remote")" \
    | grep -oE "https?://[^'\"[:space:]]+" | head -1 | sed 's:/*$::'
}

for site_file in "$SITES_DIR"/*.env; do
  site_key="$(basename "$site_file" .env)"
  [[ "$site_key" == "example-site" ]] && continue
  grep -qE "^$site_key	.+" "$MAP_FILE" && continue

  url="$( (lookup_url "$site_key") 2>/dev/null )"
  sed -i '' "/^$site_key	/d" "$MAP_FILE"
  printf '%s\t%s\n' "$site_key" "$url" >> "$MAP_FILE"
  printf '%-20s %s\n' "$site_key" "${url:-(not found)}"
done

sort -o "$MAP_FILE" "$MAP_FILE"
log "Wrote $MAP_FILE"
